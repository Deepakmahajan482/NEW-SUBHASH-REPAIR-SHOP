# ==============================================================================
# PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# Rename this file to .env and configure for your deployment server
# ==============================================================================

# Server Environment Mode ('production' in live deployment)
NODE_ENV=production

# Server Port (or assigned by your host e.g. Render / Heroku / Railway / DigitalOcean)
PORT=5000

# Production MongoDB Atlas URI
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/subhash_repair_shop?retryWrites=true&w=majority

# Strong Random JWT Secret (Generate a 64+ char random string for production)
JWT_SECRET=replace_with_a_long_random_production_secret_key_2026
JWT_EXPIRES_IN=30d

# Production Frontend Allowed Origins (Comma-separated)
CORS_ORIGIN=https://subhashagency.com,https://www.subhashagency.com

# Master Super Admin Account
SUPER_ADMIN_EMAIL=deepakmahajan3028@gmail.com
SUPER_ADMIN_DEFAULT_PASSWORD=admin123

# Maximum Upload Payload
MAX_PAYLOAD_LIMIT=25mb

# Meta WhatsApp Cloud API Version
WHATSAPP_GRAPH_VERSION=v21.0
